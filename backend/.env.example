# Backend settings. Copy this file to ".env" in the same folder and fill in the blanks.
# The real .env is ignored by git and must never be committed.
# Every variable is validated at startup in src/config/env.ts.

NODE_ENV=development
PORT=4000
# Name shown in logs and /api/health; distinguishes instances when several run.
INSTANCE_ID=api-local

# PostgreSQL. User, password, port and database must match the root .env used by
# Docker Compose:  postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_HOST_PORT>/<POSTGRES_DB>
DATABASE_URL=postgresql://chatnow:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5434/chatnow?schema=public

REDIS_URL=redis://localhost:6379

# Comma-separated browser origins allowed to call the API (the frontend dev server).
CORS_ORIGINS=http://localhost:5174
# Reverse proxies in front of the API: 0 when run directly, 1 behind Nginx.
TRUST_PROXY=0

# Signs access tokens. At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# Leave unset to get: true in production, false in development (http://localhost).
# COOKIE_SECURE=true

# redis = counters shared by all instances (use this). memory = single process only.
RATE_LIMIT_STORE=redis
# Enables @socket.io/redis-adapter for cross-instance WebSocket broadcasting.
REDIS_ADAPTER_ENABLED=true

# Optional ELK Logstash TCP endpoint (set to "logstash" inside Docker Compose).
# LOGSTASH_HOST=localhost
LOGSTASH_PORT=5044

# Directory for uploaded attachments and avatars (outside webroot).
UPLOAD_DIR=uploads

LOG_LEVEL=info

# Password given to the demo accounts created by "npm run seed" (min 10 characters).
SEED_USER_PASSWORD=
