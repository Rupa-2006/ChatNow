// ChatNow data model. See docs/02-database.md for the reasoning behind each model.
//
// Three things live only in the migration SQL because Prisma's schema language cannot
// express them: the citext / pg_trgm extensions, the expression indexes used for
// message full-text search and username trigram search, and the UserBlock CHECK
// constraint.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  FILE
  SYSTEM
}

enum NotificationType {
  NEW_MESSAGE
  ADDED_TO_GROUP
  REMOVED_FROM_GROUP
  ROLE_CHANGED
  MENTION
}

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String    @unique @db.Citext
  username          String    @unique @db.Citext
  displayName       String    @db.VarChar(50)
  passwordHash      String
  avatarUrl         String?
  bio               String?   @db.VarChar(280)
  lastSeenAt        DateTime? @db.Timestamptz(3)
  notificationPrefs Json      @default("{\"browser\":true,\"sound\":true,\"messagePreview\":true}")
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  refreshTokens        RefreshToken[]
  memberships          ConversationMember[]
  messages             Message[]
  receipts             MessageReceipt[]
  reactions            MessageReaction[]
  attachments          Attachment[]
  notifications        Notification[]
  blocksMade           UserBlock[]          @relation("Blocker")
  blocksReceived       UserBlock[]          @relation("Blocked")
  auditLogs            AuditLog[]
  conversationsCreated Conversation[]

  @@index([displayName(ops: raw("gin_trgm_ops"))], map: "User_displayName_trgm_idx", type: Gin)
}

/// One row per issued refresh token; this is the session table.
model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @db.Uuid
  /// Shared by every token descended from one login. Also the session id (`sid`) in JWTs.
  familyId     String    @db.Uuid
  /// SHA-256 of the cookie value. The raw token is never stored.
  tokenHash    String    @unique
  userAgent    String?   @db.VarChar(512)
  ipAddress    String?   @db.VarChar(64)
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model Conversation {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          ConversationType
  name          String?          @db.VarChar(80)
  avatarUrl     String?
  /// DIRECT only: "<smaller user id>:<larger user id>". Guarantees one direct chat per pair.
  directKey     String?          @unique @db.VarChar(80)
  createdById   String           @db.Uuid
  lastMessageAt DateTime?        @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(3)

  createdBy     User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  members       ConversationMember[]
  messages      Message[]
  notifications Notification[]

  @@index([lastMessageAt(sort: Desc)])
}

/// Membership row. Its existence (with leftAt = null) is the authorization check for a conversation.
model ConversationMember {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId    String     @db.Uuid
  userId            String     @db.Uuid
  role              MemberRole @default(MEMBER)
  lastReadMessageId String?    @db.Uuid
  lastReadAt        DateTime?  @db.Timestamptz(3)
  mutedUntil        DateTime?  @db.Timestamptz(3)
  joinedAt          DateTime   @default(now()) @db.Timestamptz(3)
  leftAt            DateTime?  @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, leftAt])
}

model Message {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String      @db.Uuid
  senderId       String      @db.Uuid
  type           MessageType @default(TEXT)
  content        String
  replyToId      String?     @db.Uuid
  /// Idempotency key generated by the sender; a retried send never duplicates.
  clientId       String      @db.Uuid
  editedAt       DateTime?   @db.Timestamptz(3)
  deletedAt      DateTime?   @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)

  conversation  Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender        User              @relation(fields: [senderId], references: [id], onDelete: Restrict)
  replyTo       Message?          @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies       Message[]         @relation("Replies")
  receipts      MessageReceipt[]
  reactions     MessageReaction[]
  attachments   Attachment[]
  notifications Notification[]

  @@unique([senderId, clientId])
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([replyToId])
}

model MessageReceipt {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId   String    @db.Uuid
  userId      String    @db.Uuid
  deliveredAt DateTime? @db.Timestamptz(3)
  readAt      DateTime? @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
  @@index([userId, deliveredAt])
}

model MessageReaction {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String   @db.VarChar(32)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model Attachment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Null between upload and the message that carries it being sent.
  messageId    String?  @db.Uuid
  uploaderId   String   @db.Uuid
  originalName String   @db.VarChar(255)
  /// Random name on disk; never derived from user input.
  storageKey   String   @unique
  /// Detected from file contents, not taken from the client.
  mimeType     String   @db.VarChar(127)
  sizeBytes    Int
  width        Int?
  height       Int?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  message  Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([messageId])
  @@index([uploaderId])
}

model Notification {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String           @db.Uuid
  type           NotificationType
  conversationId String?          @db.Uuid
  messageId      String?          @db.Uuid
  data           Json             @default("{}")
  readAt         DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
}

model UserBlock {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// Append-only security trail. Identifiers and metadata only: never credentials or message content.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @db.Uuid
  action     String   @db.VarChar(64)
  targetType String?  @db.VarChar(32)
  targetId   String?  @db.VarChar(64)
  ipAddress  String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(512)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}
