# Docker Compose settings. Copy this file to ".env" in the same folder and fill in
# the values. The real .env is ignored by git and must never be committed.

POSTGRES_USER=chatnow
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=
POSTGRES_DB=chatnow

# Ports published on your machine (not inside the Docker network).
POSTGRES_HOST_PORT=5434
REDIS_HOST_PORT=6379
NGINX_PORT=8080
API_1_PORT=4001
API_2_PORT=4002
KIBANA_PORT=5601
