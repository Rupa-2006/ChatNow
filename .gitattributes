# Keep LF line endings in the repository and in working copies on every OS.
# Dockerfiles, shell scripts and the Nginx / Logstash configs run inside Linux
# containers, where Windows CRLF line endings can break them.
* text=auto eol=lf

# Binary files: never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
# Documents and archives: Git's automatic text detection must never rewrite their bytes.
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip binary
