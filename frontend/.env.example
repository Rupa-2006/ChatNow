# Frontend settings (Vite exposes variables prefixed with VITE_ to the browser).
# Leave VITE_API_BASE_URL as /api when using the Vite dev proxy, Nginx, or Vercel rewrites.
VITE_API_BASE_URL=/api

# Optional explicit WebSocket origin when frontend and backend live on different domains
# (e.g. https://chatnow-api.onrender.com). Leave unset for same-origin proxy deployments.
# VITE_SOCKET_ORIGIN=https://chatnow-api.onrender.com

# Used only by the Vite dev server proxy (never bundled into client JS).
VITE_BACKEND_PROXY_TARGET=http://localhost:4000
